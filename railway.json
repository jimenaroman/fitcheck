{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "src/**",
      "pyproject.toml",
      "uv.lock",
      "railway.json",
      ".python-version"
    ]
  },
  "deploy": {
    "startCommand": "uvicorn fitcheck.api:build_app --factory --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
